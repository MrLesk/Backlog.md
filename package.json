{
  "name": "backlog.md",
  "version": "1.55.3",
  "type": "module",
  "module": "src/cli.ts",
  "files": [
    "scripts/*.cjs",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "backlog": "scripts/cli.cjs"
  },
  "optionalDependencies": {
    "backlog.md-darwin-arm64": "*",
    "backlog.md-darwin-x64": "*",
    "backlog.md-linux-arm64": "*",
    "backlog.md-linux-x64": "*",
    "backlog.md-windows-arm64": "*",
    "backlog.md-windows-x64": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@clack/core": "1.5.1",
    "@clack/prompts": "1.8.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/bun": "1.4.4",
    "@types/jsdom": "30.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-router-dom": "5.3.3",
    "@uiw/react-markdown-preview": "5.2.1",
    "@uiw/react-md-editor": "4.1.3",
    "bun-plugin-tailwind": "0.1.2",
    "commander": "15.0.0",
    "fuse.js": "7.5.0",
    "gray-matter": "4.0.3",
    "husky": "9.1.7",
    "install": "0.13.0",
    "jsdom": "30.1.3",
    "lint-staged": "17.6.0",
    "mdast-util-from-markdown": "2.1.0",
    "mermaid": "12.2.0",
    "neo-neo-bblessed": "1.0.10",
    "picocolors": "1.1.1",
    "proper-lockfile": "4.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "react-tooltip": "6.0.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "scripts": {
    "test": "bun test --timeout=10000",
    "benchmark:task-loading": "bun scripts/benchmark-task-loading.ts",
    "format": "biome format --write .",
    "lint": "biome lint --write .",
    "check": "biome check .",
    "check:types": "bun --check",
    "prepare": "husky",
    "build": "bun scripts/build.ts",
    "cli": "bun src/cli.ts",
    "mcp": "bun src/cli.ts mcp start",
    "update-nix": "node scripts/update-nix.cjs"
  },
  "lint-staged": {
    "package.json": [
      "biome check --write --files-ignore-unknown=true"
    ],
    "*.json": [
      "biome check --write --files-ignore-unknown=true"
    ],
    "src/**/*.{ts,js}": [
      "biome check --write --files-ignore-unknown=true"
    ]
  },
  "author": "Alex Gavrilescu (https://github.com/MrLesk)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLesk/Backlog.md.git"
  },
  "bugs": {
    "url": "https://github.com/MrLesk/Backlog.md/issues"
  },
  "homepage": "https://backlog.md",
  "keywords": [
    "cli",
    "markdown",
    "kanban",
    "task",
    "project-management",
    "backlog",
    "agents"
  ],
  "license": "MIT",
  "trustedDependencies": [
    "@biomejs/biome",
    "bun",
    "node-pty"
  ],
  "patchedDependencies": {
    "gray-matter@4.0.3": "patches/gray-matter@4.0.3.patch"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
